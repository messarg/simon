{
  "name": "simon",
  "private": true,
  "version": "0.0.0",
  "description": "Self-hosted trade management for small retail. See docs/prd.md.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  }
}
