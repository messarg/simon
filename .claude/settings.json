{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.db)",
      "Read(**/backups/**)"
    ],
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npm ls:*)",
      "Bash(npx tsc *)",
      "Bash(npx vite *)",
      "Bash(npx vitest *)",
      "Bash(npx oxlint *)",
      "Bash(npx prisma *)",
      "Bash(npx playwright *)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "mcp__ide__getDiagnostics"
    ]
  }
}
